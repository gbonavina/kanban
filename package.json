{
  "name": "kanban",
  "productName": "Minha Rotina",
  "desktopName": "minha-rotina.desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Quadro Scrum pessoal para a sua rotina",
  "author": "gbonavina <gabriellbona@gmail.com>",
  "homepage": "https://github.com/gbonavina/kanban",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "vite build && tsx server/main.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist-electron/main.cjs",
    "app": "vite build && npm run build:electron && electron . --no-sandbox",
    "dist": "vite build && npm run build:electron && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
